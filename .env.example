# Токен Telegram, полученный от @BotFather. MAX-токен сюда не подходит.
BOT_TOKEN=
# ID чата Telegram для уведомлений. 0 = уведомления отключены.
ADMIN_CHAT_ID=0
# polling для компьютера или VPS; webhook для Render.
BOT_MODE=polling
# Для локальной проверки оставьте пустым: будет SQLite в DB_PATH.
# На Render обязательна внешняя PostgreSQL-база.
DATABASE_URL=
DB_PATH=data/applications.db
# В режиме webhook: HTTPS-адрес сервиса без пути и завершающего /.
# Render автоматически предоставляет RENDER_EXTERNAL_URL, его достаточно.
WEBHOOK_BASE_URL=
# В webhook-режиме обязательно: случайная строка 16–256 символов A-Z a-z 0-9 _ -.
WEBHOOK_SECRET=
PORT=10000
IMAGES_ENABLED=true
